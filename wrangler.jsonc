{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mallowcord-api",
  "main": "worker/worker.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "FRONTEND_ORIGIN": "https://mallowcord-web.onrender.com",
    "GOOGLE_CLIENT_ID": "122289896698-rskbm2bbfj1advdehfai16mkjmea74f0.apps.googleusercontent.com",
    "DISCORD_CLIENT_ID": "1560534431507419148",
    "MALLOWCORD_NEON_FEATURES": "oauth_diagnostics",
    "MALLOWBOT_ICON_URL": "https://raw.githubusercontent.com/WebsiteDevelopmentStudios/Mallow-Bot/main/MallowBot.png",
    "OWNER_DISCORD_ID": "1021068313071210498",
    "OWNER_GOOGLE_EMAIL": "Wowgrayhaha@gmail.com"
  },
  "hyperdrive": [
    { "binding": "NEON", "id": "a4ab9c94f1b24b1d9a3afc983d8abdba" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mallowcord",
      "database_id": "6b781710-a658-480a-9559-ded3cd61422a"
    }
  ]
}
