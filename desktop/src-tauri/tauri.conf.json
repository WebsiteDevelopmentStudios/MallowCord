{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MallowCord",
  "version": "1.0.0",
  "identifier": "com.mallowcord.desktop",
  "build": {},
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MallowCord",
        "url": "https://mallowcord-web.onrender.com/",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "MallowCord desktop client",
    "longDescription": "The MallowCord community chat desktop application."
  }
}
