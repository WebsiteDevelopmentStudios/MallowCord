# PostgreSQL / Neon
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
MALLOWCORD_REQUIRE_DATABASE=true

# Network
MALLOWCORD_BIND_ADDR=0.0.0.0:8081
MALLOWCORD_ALLOWED_ORIGINS=https://mallowcord-web.onrender.com
MALLOWCORD_DEFAULT_SERVER_ICON=https://raw.githubusercontent.com/WebsiteDevelopmentStudios/Mallow-Bot/main/MallowBot.png
RUST_LOG=info

# Keep these values private. Never commit real values.
MALLOWCORD_INTERNAL_EVENT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MALLOWBOT_SERVICE_KEY=REUSE_THE_PRIVATE_MALLOWBOT_SERVICE_KEY
IP_HASH_SECRET=REUSE_THE_EXACT_WORKER_IP_HASH_SECRET

# Discord bridge
MALLOWCORD_DISCORD_GUILD_ID=1560367587542433812
MALLOWBOT_ICON_URL=https://raw.githubusercontent.com/WebsiteDevelopmentStudios/Mallow-Bot/main/MallowBot.png

# Optional S3-compatible object storage (for attachments)
MALLOWCORD_OBJECT_STORE_ENDPOINT=
MALLOWCORD_OBJECT_STORE_REGION=auto
MALLOWCORD_OBJECT_STORE_BUCKET=
MALLOWCORD_OBJECT_STORE_ACCESS_KEY=
MALLOWCORD_OBJECT_STORE_SECRET_KEY=
